# ==========================================
# Resend Configuration - The Minimalist Dentist
# ==========================================

# 1. Get your free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Sender email address
# Before verifying a custom domain, you can test using Resend's default sender:
RESEND_FROM="The Minimalist Dentist <onboarding@resend.dev>"

# Once you verify your domain (e.g. theminimalistdentist.in) in Resend:
# RESEND_FROM="The Minimalist Dentist <appointments@theminimalistdentist.in>"

# 3. Recipient email address
RESEND_TO="contact@theminimalistdentist.in"

# 4. Optional server port (defaults to 3000)
PORT=3000
